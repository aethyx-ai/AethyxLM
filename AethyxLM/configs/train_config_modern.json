{
  "seed": 42,
  "model": {
    "vocab_size": 32000,
    "context_length": 512,
    "embed_dim": 384,
    "num_heads": 6,
    "num_kv_heads": 2,
    "num_layers": 12,
    "ffn_dim": 1024,
    "dropout": 0.1,
    "use_bias": false,
    "layer_norm_eps": 1e-5,
    "normalization": "rmsnorm",
    "position_encoding": "rope",
    "ffn_type": "swiglu",
    "fused_qkv": true,
    "use_sdpa": true,
    "qk_norm": true,
    "rope_max_seq_len": 16384,
    "gradient_checkpointing": true
  },
  "training": {
    "learning_rate": 3e-4,
    "weight_decay": 0.1,
    "betas": [0.9, 0.95],
    "eps": 1e-8,
    "grad_clip": 1.0,
    "warmup_steps": 2000,
    "max_steps": 100000,
    "min_lr_ratio": 0.1,
    "grad_accum_steps": 16,
    "use_amp": true,
    "amp_dtype": "auto",
    "fused_optimizer": true,
    "z_loss_coefficient": 1e-4,
    "context_schedule": [
      {"step": 0, "context_length": 128},
      {"step": 10000, "context_length": 256},
      {"step": 30000, "context_length": 512}
    ],
    "torch_compile": false,
    "compile_mode": "default",
    "batch_size": 2,
    "num_workers": 0,
    "eval_interval": 1000,
    "eval_batches": 50,
    "save_interval": 1000,
    "log_interval": 50,
    "generate_interval": 999999
  },
  "data": {
    "datasets_file": "configs/datasets.json",
    "context_length": 512,
    "batch_size": 2,
    "num_workers": 0,
    "shuffle": false
  },
  "checkpoint": {
    "checkpoint_dir": "checkpoints",
    "log_interval": 10,
    "eval_interval": 1000,
    "save_interval": 1000
  },
  "tokenizer": {
    "tokenizer_file": "tokenizer/tokenizer.json",
    "vocab_size": 32000
  }
}
