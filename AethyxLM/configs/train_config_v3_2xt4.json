{
  "seed": 42,
  "model": {
    "vocab_size": 48000,
    "context_length": 1024,
    "embed_dim": 768,
    "num_heads": 12,
    "num_kv_heads": 4,
    "num_layers": 16,
    "ffn_dim": 2048,
    "dropout": 0.0,
    "use_bias": false,
    "layer_norm_eps": 1e-5,
    "normalization": "rmsnorm",
    "position_encoding": "rope",
    "ffn_type": "swiglu",
    "fused_qkv": true,
    "use_sdpa": true,
    "qk_norm": true,
    "rope_max_seq_len": 16384,
    "gradient_checkpointing": true
  },
  "training": {
    "learning_rate": 0.0003,
    "weight_decay": 0.1,
    "betas": [0.9, 0.95],
    "eps": 1e-8,
    "grad_clip": 1.0,
    "warmup_steps": 2000,
    "max_steps": 261641,
    "planned_tokens": 8000012288,
    "planned_world_size": 2,
    "min_lr_ratio": 0.1,
    "grad_accum_steps": 8,
    "use_amp": true,
    "amp_dtype": "float16",
    "fused_optimizer": true,
    "z_loss_coefficient": 0.0001,
    "context_schedule": [
      {"step": 0, "context_length": 256},
      {"step": 10000, "context_length": 512},
      {"step": 30000, "context_length": 1024}
    ],
    "torch_compile": false,
    "compile_mode": "default",
    "batch_size": 2,
    "num_workers": 2,
    "eval_interval": 1000,
    "eval_batches": 25,
    "save_interval": 1000,
    "log_interval": 50,
    "generate_interval": 10000
  },
  "data": {
    "datasets_file": "configs/datasets_v3_8b.json",
    "total_tokens": 8000000000,
    "context_length": 1024,
    "batch_size": 2,
    "num_workers": 2,
    "shuffle": false
  },
  "checkpoint": {
    "checkpoint_dir": "checkpoints/v3",
    "milestone_dir": "checkpoints/v3/milestones",
    "milestone_interval": 10000,
    "metrics_file": "logs/v3_metrics.jsonl",
    "log_dir": "logs/v3",
    "tensorboard_dir": "logs/v3/tensorboard",
    "log_interval": 50,
    "eval_interval": 1000,
    "save_interval": 1000
  },
  "tokenizer": {
    "tokenizer_file": "tokenizer/tokenizer_v3_48k.json",
    "vocab_size": 48000
  }
}
