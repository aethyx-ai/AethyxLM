{
  "seed": 42,
"model": {
    "vocab_size": 32000,
    "context_length": 64,
    "embed_dim": 128,
    "num_heads": 4,
    "num_layers": 4,
    "ffn_dim": 512,
    "dropout": 0.1,
    "use_bias": true,
    "layer_norm_eps": 1e-05
  },
  "training": {
    "learning_rate": 3e-4,
    "weight_decay": 0.1,
    "betas": [
      0.9,
      0.95
    ],
    "eps": 1e-08,
    "grad_clip": 1.0,
    "warmup_steps": 100,
    "max_steps": 20000,
    "min_lr_ratio": 0.1,
    "grad_accum_steps": 4,
    "use_amp": true,
    "batch_size": 8,
    "num_workers": 0,
    "eval_interval": 999999,
    "save_interval": 500,
    "log_interval": 50,
    "generate_interval": 999999
  },
"data": {
    "train_file": "data/train.txt",
    "val_file": "data/val.txt",
    "context_length": 64,
    "batch_size": 8,
    "num_workers": 0,
    "shuffle": false
  },
  "checkpoint": {
    "checkpoint_dir": "checkpoints",
    "log_interval": 10,
    "eval_interval": 500,
    "save_interval": 1000
  },
  "tokenizer": {
    "tokenizer_file": "tokenizer/tokenizer.json",
    "vocab_size": 32000
  }
}